# WooCommerce backend (read-only REST keys; create under WooCommerce > Settings > Advanced > REST API)
WC_API_URL="https://shop.example.nl"
WC_CONSUMER_KEY=""
WC_CONSUMER_SECRET=""

# Public site URL (used for metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL="https://e-bike-tekoop.nl"

# Reply Portal: set these in Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# Zoho Mail SMTP for verkoop@e-bike-tekoop.nl (use an app-specific password, not the account password)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=verkoop@e-bike-tekoop.nl
SMTP_PASS=
SMTP_FROM=verkoop@e-bike-tekoop.nl

# Optional: redirect where notifications land without a redeploy (default verkoop@e-bike-tekoop.nl)
# ORDER_EMAIL=
# CONTACT_EMAIL=

# Passcode for /admin (long and random)
ADMIN_PASSCODE=

# Upstash Redis: added automatically by Vercel -> Storage -> Create Database -> Upstash for Redis
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN or KV_REST_API_URL / KV_REST_API_TOKEN)

# Deliverability (DNS at Hostinger, not code): SPF, DKIM and DMARC records for Zoho, see Zoho Mail admin -> Domains.
